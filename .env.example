# Copier ce fichier en .env puis adapter les valeurs.
# Les variables sont lues par docker-compose et par le backend Spring Boot.

# --- Base de données ---
POSTGRES_DB=coworkspace
POSTGRES_USER=coworkspace
POSTGRES_PASSWORD=coworkspace
# Port exposé sur la machine (changer si 5432 est déjà utilisé)
DB_PORT=5432

# --- Sécurité ---
# Secret de signature des JWT : au moins 32 caractères aléatoires.
# Générer avec : openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-secret-of-at-least-32-chars

# --- Emails (Mailpit en local) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM=no-reply@coworkspace.local

# --- URL du frontend (liens dans les emails, CORS) ---
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
